PROJECT_NAME=flashscale-dlt
AWS_REGION=us-west-2
NODE_ENV=production
API_PORT=3000
API_REPLICAS=2
WORKER_REPLICAS=1
REDIS_URL=redis://redis:6379
ORDER_PROCESSING_MS=25
PRODUCT_COUNT=100
LOG_LEVEL=info

# SNS email alerts for traffic thresholds
# ALERT_EMAIL must be set before running scripts/setup-sns-alerts.sh
ALERT_EMAIL=your-email@gmail.com
SNS_TOPIC_NAME=flashscale-dlt-traffic-alerts
ALERT_THRESHOLDS=10000,20000,30000,40000,50000,60000,70000,80000,90000,100000
ALERT_PERIOD_SECONDS=60
ALERT_EVALUATION_PERIODS=1
ALERT_METRIC=NginxRequestCount
ALERT_STAT=Sum


# AIOps Lab
# Anomaly alarms need baseline traffic before they become useful.
AIOPS_SCENARIO_TTL_SECONDS=900
AIOPS_ALERT_EMAIL=your-email@gmail.com
AIOPS_SNS_TOPIC_NAME=flashscale-dlt-traffic-alerts
AIOPS_ANOMALY_PERIOD_SECONDS=60
AIOPS_ANOMALY_EVALUATION_PERIODS=2
AIOPS_ANOMALY_STDDEV=2
AIOPS_QUEUE_DEPTH_THRESHOLD=1000
AIOPS_5XX_THRESHOLD=10
